      "parameters": {
        "fromEmail": "noreply@presupuestoya.com",
        "toEmail": "admin@presupuestoya.com",
        "subject": "❌ Lead Rechazado - Datos Inválidos: {{$json.name}}",
        "textOnly": false,
        "htmlBody": "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <div style=\"background: #d33b27; color: white; padding: 20px; border-radius: 8px 8px 0 0;\">\n    <h1 style=\"margin: 0;\">❌ Validación Fallida</h1>\n  </div>\n  <div style=\"padding: 20px; border: 1px solid #e8eaed; border-top: none;\">\n    <p>El siguiente lead fue <strong>rechazado</strong> por datos inválidos:</p>\n    \n    <div style=\"background: #fce8e6; padding: 15px; border-radius: 6px; margin: 20px 0;\">\n      <pre style=\"margin: 0; white-space: pre-wrap; font-size: 12px;\">{{JSON.stringify($json, null, 2)}}</pre>\n    </div>\n    \n    <p style=\"color: #5f6368; font-size: 13px;\">\n      Por favor revisa los datos del formulario.\n    </p>\n  </div>\n</div>"
      },
      "id": "14-email-validation-error",

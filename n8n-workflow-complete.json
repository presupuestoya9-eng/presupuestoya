        "fromEmail": "noreply@presupuestoya.com",
        "toEmail": "admin@presupuestoya.com",
        "subject": "⚠️ Lead Sin Profesional Disponible: {{$json.name}} ({{$json.detectedRegion}})",
        "textOnly": false,
        "htmlBody": "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <div style=\"background: #d33b27; color: white; padding: 20px; border-radius: 8px 8px 0 0;\">\n    <h1 style=\"margin: 0;\">⚠️ Revisión Manual Requerida</h1>\n  </div>\n  <div style=\"padding: 20px; border: 1px solid #e8eaed; border-top: none;\">\n    <p><strong>No hay profesionales disponibles</strong> para este lead.</p>\n    \n    <div style=\"background: #fce8e6; padding: 15px; border-radius: 6px; margin: 20px 0;\">\n      <h3 style=\"margin-top: 0;\">📋 Datos del Cliente:</h3>\n      <ul style=\"margin: 10px 0;\">\n        <li><strong>Nombre:</strong> {{$json.name}}</li>\n        <li><strong>Email:</strong> {{$json.email}}</li>\n        <li><strong>Teléfono:</strong> {{$json.phone}}</li>\n        <li><strong>Región:</strong> {{$json.detectedRegion}}</li>\n        <li><strong>Tipo:</strong> {{$json.closureType}}</li>\n      </ul>\n    </div>\n    \n    <h3>Acciones:</h3>\n    <ol>\n      <li>Entra al dashboard de Airtable</li>\n      <li>Busca este lead en tabla \"Leads\" con Status \"New\"</li>\n      <li>Asigna manualmente a un profesional</li>\n      <li>Notifica al profesional por email</li>\n    </ol>\n  </div>\n</div>"
      },

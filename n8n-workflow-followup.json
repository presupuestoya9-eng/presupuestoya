        "table": "Leads",
        "id": "={{$json.id}}",
        "fields": {
          "Status": "Completed"
        }
      },
      "id": "11-mark-as-completed-if-exists",
      "name": "Auto-complete if No Response (7 days)",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 3,
      "position": [
        850,
        450
      ],
      "credentials": {
        "airtableApi": "airtable_oauth2"
      },
      "disabled": true
    },
    {
      "parameters": {
        "mode": "immediately",
        "includeExecutionData": true
      },
      "id": "12-log-complete",
      "name": "Log Success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    }
  ],

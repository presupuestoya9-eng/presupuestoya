# Presupuestoya Environment Configuration

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Webhook URL - Where to send leads
# Examples:
# - n8n: https://your-instance.n8n.cloud/webhook/abc123xyz
# - Zapier: https://hooks.zapier.com/hooks/catch/abc123/xyz789/
# - Custom: https://your-server.com/api/leads
WEBHOOK_URL=https://your-webhook-url.com/leads

# Optional: API Key if your webhook requires authentication
# WEBHOOK_API_KEY=your-api-key-here

# Optional: Custom headers for webhook (JSON format)
# WEBHOOK_HEADERS={"Authorization": "Bearer token", "X-Custom": "value"}

# Enable detailed logging
DEBUG=false
